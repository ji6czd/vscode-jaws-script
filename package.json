{
  "name": "vscode-jaws-script",
  "displayName": "JAWS Script",
  "description": "JAWS Script language support for VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:jaws-script"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "jawsScript.compile",
        "title": "JAWS Script: Compile",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "jawsScript.compile",
          "when": "resourceLangId == jaws-script"
        }
      ]
    },
    "configuration": {
      "title": "JAWS Script",
      "properties": {
        "jawsScript.includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Include で指定したファイルを探す追加のフォルダー。開いているファイルのフォルダー、ワークスペースのフォルダー、インストールされている JAWS のフォルダーは、この設定がなくても探します。"
        },
        "jawsScript.compilerPath": {
          "type": "string",
          "default": "",
          "description": "JAWS のスクリプトコンパイラ(scompile.exe)のパス。空のときは、インストールされている JAWS(jawsScript.jawsVersion で指定したバージョン、なければ最新)から探します。"
        },
        "jawsScript.jawsVersion": {
          "type": "string",
          "default": "",
          "description": "Include を探すときに使う JAWS のバージョン(例: 2026)。空のときは、インストールされている最新のバージョンを使います。"
        },
        "jawsScript.language": {
          "type": "string",
          "default": "",
          "description": "Include を探すときに使う JAWS の言語フォルダー名(例: jpn、enu)。空のときは、VS Code の表示言語に合わせて自動で選びます。"
        }
      }
    },
    "languages": [
      {
        "id": "jaws-script",
        "aliases": [
          "JAWS Script",
          "jss"
        ],
        "extensions": [
          ".jss"
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "pnpm run compile"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/vscode": "^1.140.0",
    "typescript": "^7.0.2"
  }
}
